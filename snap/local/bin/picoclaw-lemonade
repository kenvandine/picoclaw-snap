#!/bin/sh
# picoclaw-lemonade — interactive Lemonade model picker for PicoClaw.
#
# Probes the local lemonade-server, presents a TUI to choose one of its loaded
# models, and configures it as PicoClaw's default model via the official
# `picoclaw model add` command (an OpenAI-compatible endpoint), then restarts
# the gateway so the change takes effect.
#
# Run as:  picoclaw.lemonade [--auto]
#
# --auto: non-interactive; picks the first available chat model and configures
#         it without user interaction.  Also installs the systemd user service
#         unit if it has not been set up yet (safe to run on first install).
#
# PicoClaw is a dependency-free static binary, so this picker is pure POSIX sh
# + curl (the same approach as nullclaw), rather than the Node TUI used by
# Node-based claw snaps.

CLI="${CLAW_CLI_NAME:-picoclaw}"
LEMONADE_HOST="${CLAW_LEMONADE_HOST:-127.0.0.1}"
LEMONADE_PORT="${CLAW_LEMONADE_PORT:-13305}"
LEMONADE_API="http://${LEMONADE_HOST}:${LEMONADE_PORT}/api/v1"
PICOCLAW="$SNAP/bin/picoclaw"
CURL="$SNAP/usr/bin/curl"
SERVICE_NAME="${CLI}"

log() { printf '%s: %s\n' "$CLI" "$1"; }
err() { printf '%s: %s\n' "$CLI" "$1" >&2; }

# Parse arguments.
AUTO=0
GATEWAY_HOST=""
MODEL=""
_prev=""
for arg in "$@"; do
  [ "$_prev" = "--host" ]  && { GATEWAY_HOST="$arg"; _prev=""; continue; }
  [ "$_prev" = "--model" ] && { MODEL="$arg"; _prev=""; continue; }
  case "$arg" in
    --auto) AUTO=1 ;;
    --host=*)  GATEWAY_HOST="${arg#--host=}" ;;
    --host)    _prev="--host" ;;
    --model=*) MODEL="${arg#--model=}" ;;
    --model)   _prev="--model" ;;
    *) err "unknown argument: $arg"; exit 1 ;;
  esac
  _prev="$arg"
done

# Install (or refresh) the systemd user service unit.  Called by --auto so
# the service is available even when the main launcher has not been run yet.
_install_service_unit() {
  local unit_src="$SNAP/share/systemd/user/${SERVICE_NAME}.service"
  local unit_dir="$HOME/.config/systemd/user"
  local unit_dst="$unit_dir/${SERVICE_NAME}.service"
  [ -f "$unit_src" ] || return 0
  mkdir -p "$unit_dir"
  if [ ! -f "$unit_dst" ] || ! cmp -s "$unit_src" "$unit_dst"; then
    cp "$unit_src" "$unit_dst"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
  if ! systemctl --user is-enabled "$SERVICE_NAME" >/dev/null 2>&1; then
    systemctl --user enable --now "$SERVICE_NAME" 2>/dev/null || true
  fi
}

# If --host was supplied, patch gateway.host in config.json before the service
# starts.  Allows callers (e.g. Nimbus) to bind to 0.0.0.0 for container proxy
# access without changing the safe localhost default for interactive installs.
_set_gateway_host() {
  [ -n "$GATEWAY_HOST" ] || return 0
  local cfg="$HOME/.picoclaw/config.json"
  [ -f "$cfg" ] || return 0
  python3 -c "
import json, sys
p, h = sys.argv[1], sys.argv[2]
with open(p) as f:
    c = json.load(f)
c.setdefault('gateway', {})['host'] = h
with open(p, 'w') as f:
    json.dump(c, f, indent=2)
    f.write('\n')
" "$cfg" "$GATEWAY_HOST" 2>/dev/null || true
}

# Dynamically optimize max_tokens and other config settings based on host RAM
# and the chosen model's context window capabilities, avoiding OOM and lag.
_optimize_defaults() {
  local cfg="$HOME/.picoclaw/config.json"
  [ -f "$cfg" ] || return 0

  res=$(python3 -c "
import json, sys, urllib.request

cfg_path = sys.argv[1]
selected_model = sys.argv[2]
api_url = sys.argv[3]

def get_total_ram_gb():
    try:
        with open('/proc/meminfo', 'r') as f:
            for line in f:
                if line.startswith('MemTotal:'):
                    parts = line.split()
                    return int(parts[1]) / (1024 * 1024)
    except Exception:
        pass
    return 8.0

def get_model_context_limit(api_url, model_id):
    try:
        req = urllib.request.Request('{}/models'.format(api_url), headers={'User-Agent': 'picoclaw-lemonade'})
        with urllib.request.urlopen(req, timeout=3) as response:
            data = json.loads(response.read().decode('utf-8'))
            models = data if isinstance(data, list) else data.get('data', [])
            for m in models:
                if m.get('id') == model_id:
                    recipe_opts = m.get('recipe_options', {}) or {}
                    ctx_size = recipe_opts.get('ctx_size')
                    if ctx_size and int(ctx_size) > 0:
                        return int(ctx_size)
                    max_ctx = m.get('max_context_window')
                    if max_ctx and int(max_ctx) > 0:
                        return int(max_ctx)
    except Exception:
        pass
    return 4096

try:
    with open(cfg_path, 'r') as f:
        config = json.load(f)

    ram = get_total_ram_gb()
    if ram < 6.0:
        optimal = 2048
    elif ram < 12.0:
        optimal = 4096
    elif ram < 24.0:
        optimal = 8192
    elif ram < 48.0:
        optimal = 16384
    else:
        optimal = 32768

    model_limit = get_model_context_limit(api_url, selected_model)
    final_max_tokens = max(2048, min(optimal, model_limit))

    if final_max_tokens <= 2048:
        threshold = 10
    elif final_max_tokens <= 4096:
        threshold = 15
    else:
        threshold = 20

    agents = config.setdefault('agents', {})
    defaults = agents.setdefault('defaults', {})
    defaults['max_tokens'] = final_max_tokens
    defaults['summarize_message_threshold'] = threshold

    model_alias = 'lemonade-{}'.format(selected_model)
    for m in config.get('model_list', []):
        if m.get('model_name') == model_alias:
            m.pop('max_context_window', None)
            m.pop('context_window', None)
            m.pop('context_size', None)

    with open(cfg_path, 'w') as f:
        json.dump(config, f, indent=2)
        f.write('\n')

    print('Success|{:.1f}|{}|{}|{}'.format(ram, model_limit, final_max_tokens, threshold))
except Exception as e:
    print('Error|{}'.format(str(e)))
" "$cfg" "$1" "$LEMONADE_API" 2>/dev/null)

  case "$res" in
    Success*)
      ram=$(printf '%s' "$res" | cut -d'|' -f2)
      model_limit=$(printf '%s' "$res" | cut -d'|' -f3)
      max_tokens=$(printf '%s' "$res" | cut -d'|' -f4)
      threshold=$(printf '%s' "$res" | cut -d'|' -f5)
      log "optimized: max_tokens=${max_tokens}, threshold=${threshold} (RAM: ${ram}GB, Model max: ${model_limit})"
      ;;
  esac
}

mkdir -p "$HOME/.picoclaw"
[ -f "$HOME/.picoclaw/config.json" ] || "$PICOCLAW" onboard >/dev/null 2>&1 || true

score_model() {
  lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    *flux*|*sdxl*|*stable?diff*) printf '%s\n' -30; return ;;
    *kokoro*|*whisper*|*tts*|*speech*) printf '%s\n' -20; return ;;
    *embed*|*retriev*|*rerank*) printf '%s\n' -20; return ;;
  esac
  score=0
  case "$lower" in *flm*)               score=$((score + 20)) ;; esac
  case "$lower" in *gguf*)              score=$((score + 10)) ;; esac
  case "$lower" in *instruct*|*-it-*|*chat*) score=$((score + 5)) ;; esac
  printf '%s\n' "$score"
}

pick_best() {
  best_id=""; best_score=-999
  while IFS= read -r id; do
    [ -z "$id" ] && continue
    s=$(score_model "$id")
    if [ "$s" -ge 0 ] && [ "$s" -gt "$best_score" ]; then
      best_score="$s"; best_id="$id"
    fi
  done
  [ -n "$best_id" ] && printf '%s\n' "$best_id"
}

probe_models() {
  "$CURL" -sf --connect-timeout 3 --max-time 5 "${LEMONADE_API}/models" 2>/dev/null \
    | grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | sed 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
}

# Models that are not chat/completion models; hide them from the picker.
is_non_chat() {
  lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    *flux*|*sdxl*|*stable?diff*) return 0 ;;
    *kokoro*|*whisper*|*tts*|*speech*) return 0 ;;
    *embed*|*retriev*|*rerank*) return 0 ;;
  esac
  return 1
}

# Configure PicoClaw to use a lemonade model as default (skips the network
# call/picker because -m is given; also sets it as the default model).
configure() {
  "$PICOCLAW" --no-color model add \
    -b "$LEMONADE_API" -k lemonade -m "$1" -n "lemonade-$1" >/dev/null 2>&1
}

ALL_MODELS=$(probe_models)
if [ -z "$ALL_MODELS" ]; then
  err "lemonade-server not detected at ${LEMONADE_HOST}:${LEMONADE_PORT}"
  err "start lemonade-server, then run '${CLI}.lemonade' again"
  exit 1
fi

MODELS=""
for m in $ALL_MODELS; do
  is_non_chat "$m" && continue
  MODELS="${MODELS}${m}
"
done
MODELS=$(printf '%s' "$MODELS" | sed '/^$/d')
COUNT=$(printf '%s\n' "$MODELS" | grep -c .)
if [ "$COUNT" -eq 0 ]; then
  MODELS=$(printf '%s\n' "$ALL_MODELS" | sed '/^$/d')
  COUNT=$(printf '%s\n' "$MODELS" | grep -c .)
fi

# Non-interactive: --auto flag or no TTY.
if [ "$AUTO" -eq 1 ] || [ ! -t 0 ] || [ ! -t 1 ]; then
  if [ "$AUTO" -eq 1 ]; then
    if [ -n "$MODEL" ]; then
      SELECTED="$MODEL"
    else
      SELECTED=$(printf '%s\n' "$MODELS" | pick_best)
      [ -z "$SELECTED" ] && SELECTED=$(printf '%s\n' "$MODELS" | head -1)
    fi
    _install_service_unit
    _set_gateway_host
    if configure "$SELECTED"; then
      _optimize_defaults "$SELECTED"
      log "auto-configured lemonade-${SELECTED}"
      systemctl --user restart "$CLI" >/dev/null 2>&1 || true
      exit 0
    fi
    err "failed to configure ${SELECTED}"
    exit 1
  else
    SELECTED=$(printf '%s\n' "$MODELS" | head -1)
    if configure "$SELECTED"; then
      _optimize_defaults "$SELECTED"
      log "configured lemonade-${SELECTED} (non-interactive)"
      systemctl --user restart "$CLI" >/dev/null 2>&1 || true
      exit 0
    fi
    err "failed to configure ${SELECTED}"
    exit 1
  fi
fi

printf '\nPicoClaw detected Lemonade at %s.\n' "$LEMONADE_API"
printf 'Choose a model to use as the default:\n\n'

i=1
printf '%s\n' "$MODELS" | while IFS= read -r m; do
  [ -z "$m" ] && continue
  printf '  %d. %s\n' "$i" "$m"
  i=$((i + 1))
done
printf '\n'

while true; do
  printf 'Model number [1]: '
  read -r choice
  [ -z "$choice" ] && choice=1
  case "$choice" in
    ''|*[!0-9]*) continue ;;
  esac
  if [ "$choice" -ge 1 ] && [ "$choice" -le "$COUNT" ]; then
    break
  fi
done

SELECTED=$(printf '%s\n' "$MODELS" | sed -n "${choice}p")

if configure "$SELECTED"; then
  _optimize_defaults "$SELECTED"
  log "default model -> lemonade-${SELECTED}  (${LEMONADE_API})"
  if systemctl --user restart "$CLI" >/dev/null 2>&1; then
    log "restarted the gateway service"
  else
    log "run 'systemctl --user restart ${CLI}' to apply"
  fi
else
  err "failed to configure ${SELECTED}"
  exit 1
fi
